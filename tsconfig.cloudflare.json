{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "src/app/**/*",
    "src/app/**/.server/**/*",
    "src/app/**/.client/**/*",
    "src/workers/**/*",
    "src/schema/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ESNext"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
