{
  "extends": "./.void/tsconfig.json",
  "include": [
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "routes/**/*.ts",
    "routes/**/*.tsx",
    "middleware/**/*.ts",
    "durable-objects/**/*.ts",
    "db/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "auth.ts",
    "env.ts",
    "vite.config.ts",
    "void.config.ts"
  ],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@/server/*": ["./src/server/*"],
      "@/*": ["./src/app/*"],
      "src/*": ["./src/*"],
      "@schema": ["./db/schema.ts"],
      "@schema/*": ["./db/schema/*"],
      "void/db": ["./.void/db.d.ts"]
    },
    "types": ["void/env"]
  }
}
