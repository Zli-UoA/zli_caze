{
  "extends": "./.void/tsconfig.json",
  "include": [
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "routes/**/*.ts",
    "routes/**/*.tsx",
    "durable-objects/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "void.config.ts"
  ],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/app/*"],
      "src/*": ["./src/*"]
    },
    "types": ["void/env"]
  }
}
